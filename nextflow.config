process.cache = 'deep'

import java.time.*
Date now = new Date()

params {
	day = now.format("yyyMMdd")
    timestamp = now.format("yyyyMMdd-HH-mm-ss")
    out = "Analysis_Results-${day}"
    tracedir = "${out}"
    debug = false
    help = false
    params.report = false
    params.finemap = true
    params.burden = true
    params.manplot = false
    params.p3d 		 = false
    params.sthresh   = "BF"
    params.freqUpper = 0.05
    params.minburden = 2
    params.group_qtl = 1000
    params.ci_size   = 150
    params.fix_names = "fix"
	params.vcf = "20231213"
}

// set up profiles
profiles {
    standard { includeConfig 'conf/rockfish.config' }
    rockfish { includeConfig 'conf/rockfish.config' }
    quest { includeConfig 'conf/quest.config' }
}

timeline {
	enabled = true
	file = "${params.tracedir}/${params.timestamp}_timeline.html"
}

process.container = "andersenlab/cegwas2:latest"